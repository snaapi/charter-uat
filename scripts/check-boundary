#!/bin/sh
# Fail when a CUE or YAML file names a database or a database client.
# Charter starts the database. This module never sees it.
set -eu

cd "$(dirname "$0")/.."

if grep -RInE --include='*.cue' --include='*.yaml' --exclude-dir=cue.mod \
	-e 'DATABASE_URL' \
	-e 'postgres://' \
	-e 'sqlite:' \
	-e 'psql' \
	-e 'sqlite3' \
	.
then
	echo "check-boundary: CUE and YAML files must not mention a database" >&2
	exit 1
fi
