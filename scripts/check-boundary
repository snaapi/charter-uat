#!/bin/sh
# Fail when a CUE file names a database or a database client.
# A scenario is given baseURL and a charter on PATH. It does not open
# a database.
set -eu

cd "$(dirname "$0")/.."

if grep -RInE --include='*.cue' --exclude-dir=cue.mod \
	-e 'DATABASE_URL' \
	-e 'postgres://' \
	-e 'sqlite:' \
	-e 'psql' \
	-e 'sqlite3' \
	.
then
	echo "check-boundary: CUE files must not mention a database" >&2
	exit 1
fi
